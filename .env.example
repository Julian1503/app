# Copiar a .env y completar. NUNCA commitear el .env.

# --- Deputy OAuth ---
# Se obtienen registrando un cliente OAuth en https://once.deputy.com/my/oauth/list
# Redirect URI a registrar: http://localhost:8787/api/auth/callback
DEPUTY_CLIENT_ID=tu-client-id
DEPUTY_CLIENT_SECRET=tu-client-secret

# URL del install del empleador (sin barra final).
# Si el token de Deputy devuelve otro endpoint, gana el que devuelve Deputy.
DEPUTY_INSTALL_URL=https://47924c10020044.au.deputy.com

# Tu employeeId dentro del install: un numero entero, no el id de la app OAuth.
# Si lo dejas vacio se resuelve solo via /api/v1/me (o /api/me/v2 como fallback).
DEPUTY_EMPLOYEE_ID=

# --- Supabase ---
# Se crean en https://supabase.com -> New project. Las claves estan en
# Project Settings -> API.
# URL del proyecto, sin barra final.
SUPABASE_URL=https://tu-proyecto.supabase.co
# service_role key, NO la anon. Salta RLS: nunca la pongas en el front.
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor ---
# Puerto local. En un host desplegado no se usa: la plataforma inyecta PORT y
# gana ese. Igual hace falta para `npm run dev`.
SERVER_PORT=8787

# Origen del front. Es el Access-Control-Allow-Origin y el destino al que Deputy
# te devuelve despues del login, asi que en produccion tiene que ser la URL
# publica del front, no localhost.
WEB_ORIGIN=http://localhost:5173

# Origen publico del API, sin barra final. De aca sale el redirect de OAuth, que
# ademas hay que registrar igual en Deputy. Vacio = http://localhost:SERVER_PORT
PUBLIC_API_URL=

# Interfaz donde escucha. Por defecto 127.0.0.1: la app no tiene login todavia,
# asi que el loopback es la unica proteccion. Un host desplegado necesita
# 0.0.0.0, pero no lo pongas hasta que exista la autenticacion.
HOST=127.0.0.1

# --- Reglas de negocio ---
# Limite de horas por quincena de la condicion 8105
VISA_FORTNIGHT_LIMIT=48
# Tarifa de reembolso por km que paga el empleador
KM_RATE=0.99
# Carpeta con los payslips PDF (relativa a app/ o absoluta).
# Solo la lee el importador (`npm run payslips:import`), que parsea los PDF y
# guarda el resultado en Supabase. El servidor ya no toca esta carpeta.
PAYSLIPS_DIR=../payslips

# --- Reportes de turno ---
# Clave del API de Claude, para redactar los reportes.
# Se obtiene en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo a usar. Vacio = claude-opus-5
ANTHROPIC_MODEL=
# Nombre del cliente tal como figura en el location del turno en Deputy.
REPORTS_CLIENT_NAME=Joshua Jones
# Primer dia que lleva reporte (YYYY-MM-DD).
REPORTS_START_DATE=2026-08-16

# Tu nombre, para Q1 ("Name of person completing this form").
# Vacio = la app te lo pregunta en vez de suponerlo.
REPORTS_WORKER_NAME=
